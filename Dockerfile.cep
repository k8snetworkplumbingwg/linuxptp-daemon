FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS builder
USER root
WORKDIR /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon

COPY go.mod go.sum ./
COPY vendor vendor

COPY addons addons
COPY cmd cmd
COPY deploy deploy
COPY hack hack
COPY Makefile Makefile
COPY pkg pkg
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=${GIT_COMMIT}
# Optional Go build tags. Empty by default; set --build-arg GO_BUILD_TAGS=pprof
# to build a profiling-enabled image (adds the pprof endpoints, see pkg/profiling).
ARG GO_BUILD_TAGS=
RUN --mount=type=cache,target=/root/.cache/go-build make GO_BUILD_TAGS="${GO_BUILD_TAGS}"

FROM quay.io/centos/centos:stream9

COPY --from=builder /go/src/github.com/k8snetworkplumbingwg/linuxptp-daemon/bin/cloud-event-proxy /usr/local/bin/

CMD ["/usr/local/bin/cloud-event-proxy"]
